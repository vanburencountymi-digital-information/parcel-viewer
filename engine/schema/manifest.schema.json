{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dice.vanburencountymi.gov/isv/manifest.schema.json",
  "title": "ISV Theme Manifest",
  "description": "The versioned, declarative document that defines one viewer (ISV_BUILD_SPEC §5). The platform's public API. PROVISIONAL v1 (A1/C2): the shape is expected to grow; manifestVersion versions THIS shape. Source-agnostic: describes 'sources', never 'parcels'.",
  "type": "object",
  "required": ["manifestVersion", "id", "tenant", "map", "sources", "capabilities"],
  "additionalProperties": true,
  "properties": {
    "manifestVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$",
      "description": "SCHEMA version of the manifest shape (engine declares which it supports + migrates older). Distinct from config-instance versioning."
    },
    "id": { "type": "string", "minLength": 1 },
    "tenant": {
      "type": "string",
      "minLength": 1,
      "description": "Tenant/county scoping key (§4.13 tenant isolation is security)."
    },
    "branding": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string" },
        "logo": { "type": "string" },
        "attribution": { "type": "string" },
        "theme": {
          "type": "object",
          "description": "CSS custom-property tokens.",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "map": {
      "type": "object",
      "required": ["center", "zoom"],
      "additionalProperties": true,
      "properties": {
        "style": { "type": "string" },
        "center": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2
        },
        "zoom": { "type": "number", "minimum": 0, "maximum": 24 },
        "extent": { "type": "array" }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "description": "Vector/raster sources the engine renders. The engine reads 'a source with an idField, search, popup, hover, styling' — never 'parcels'.",
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "enum": ["vector", "raster", "wms", "geojson"] },
          "tiles": { "type": "string" },
          "url": { "type": "string" },
          "idField": { "type": "string" },
          "search": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "fields": { "type": "array", "items": { "type": "string" } },
              "endpoint": { "type": "string" }
            }
          },
          "popup": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "sections": { "type": "array", "items": { "type": "string" } }
            }
          },
          "hover": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "enabled": { "type": "boolean" },
              "fields": { "type": "array", "items": { "type": "string" } }
            }
          },
          "detail": {
            "type": "object",
            "additionalProperties": true,
            "properties": { "endpoint": { "type": "string" } }
          },
          "style": { "type": "object", "description": "Per-source rendering config (paint/line/point/labels), per theme. Source-agnostic; the renderer maps it to MapLibre paint." },
          "legend": { "type": "string" },
          "label": { "type": "string" },
          "sourceLayer": { "type": "string", "description": "The vector tile source-layer name within the tileset." },
          "minZoom": { "type": "number", "minimum": 0, "maximum": 24 },
          "source": { "type": "string", "description": "Tile-function / provider name (e.g. a Martin function) or a human source note." },
          "geomType": { "type": "string", "enum": ["polygon", "line", "point"] },
          "dbSource": { "type": "string", "description": "Provenance note: the backing table/dataset." },
          "fields": { "type": "array", "items": { "type": "string" }, "description": "Queryable/displayable attribute names for this source." },
          "default": { "type": "boolean", "description": "Whether this source/overlay is on by default." },
          "role": { "type": "string", "enum": ["base", "overlay", "county-overlay"], "description": "Base layer vs. toggleable overlay vs. county PostGIS overlay — lets a renderer select the right set." },
          "outlineOnly": { "type": "boolean", "description": "Render polygons as outline only (no fill)." },
          "martin": { "type": "string", "description": "County-overlay Martin tile-function name." },
          "geom": { "type": "string", "enum": ["polygon", "line", "point"], "description": "County-overlay geometry kind (legacy key)." },
          "minzoom": { "type": "number", "minimum": 0, "maximum": 24, "description": "County-overlay min zoom (legacy lowercase key)." },
          "paint": { "type": "object", "description": "County-overlay inline paint overrides (fill/line/circle)." },
          "beforeLayer": { "type": "string", "description": "Insert the overlay before this map layer id." }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "description": "Per-capability config. Each value carries an AI tri-state (§4.7) and an optional disclosure level.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "ai": { "type": "string", "enum": ["no-ai", "ai-optional", "ai-required"] },
          "disclosure": { "type": "string", "enum": ["basic", "advanced", "hidden"] }
        }
      }
    },
    "persona": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "voice": { "type": "string" },
        "audience": { "type": "string", "enum": ["public", "staff"] }
      }
    },
    "mapBuddy": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "apiBase": { "type": "string" },
        "knowledge": { "type": "string" }
      }
    },
    "plugins": { "type": "array", "items": { "type": "string" } },

    "state": { "type": "string", "description": "State/province (e.g. 'MI')." },
    "parcelNumber": {
      "type": "object",
      "additionalProperties": true,
      "description": "Per-tenant parcel-number format (label, separator, segments). Absorbed from county-config so the manifest is the single config artifact the viewer boots from (the explainer's PIN breakdown reads this)."
    },
    "labels": {
      "type": "object",
      "additionalProperties": true,
      "description": "Per-tenant code→name lookups (property classes, school districts) the viewer renders. Absorbed from county-config."
    },
    "styling": {
      "type": "object",
      "additionalProperties": true,
      "description": "Per-tenant styling config (color schemes, per-layer paint, label defaults). branding.theme holds the §5 token subset; this is the full styling block. Absorbed from county-config."
    },
    "forms": { "type": "object", "additionalProperties": true, "description": "External destinations (data-request form, …)." },
    "endpoints": { "type": "object", "additionalProperties": true, "description": "Per-deployment service endpoints (mapBuddy AI, …)." },
    "integrations": { "type": "object", "additionalProperties": true, "description": "Third-party integration config (Street View key, …)." },
    "access": { "type": "object", "additionalProperties": true, "description": "Access/ops facts (model, report inbox, rate-limited flag)." }
  }
}
