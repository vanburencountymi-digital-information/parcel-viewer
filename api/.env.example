# Parcel viewer API (Django). Locally, docker compose sets DATABASE_URL and passes the
# parcel URLs through from the repo-root .env, so this file is only for running outside
# compose. Never commit a real .env.

ENVIRONMENT=local
SECRET_KEY=insecure-local-dev-key-change-me
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1

# Django's own tables (auth, sessions, admin). The only database Django migrates.
DATABASE_URL=postgis://api:api@localhost:5433/parcel_viewer_api
# The shared parcel database. The API opens it read-only (ADR 0007).
PV_DATABASE_URL=
# The county config store (config.config_versions). Empty: use DATABASE_URL (ADR 0010).
PV_WRITER_DATABASE_URL=

# Optional
DB_POOL_MAX=5
DB_STATEMENT_TIMEOUT_MS=10000
THROTTLE_ANON=120/min
THROTTLE_USER=600/min
THROTTLE_NUM_PROXIES=
THROTTLE_LOGIN=10/min

# Staff sign-in (ADR 0013). PV_ADMIN_SHARED_KEY=0 stops the admin routes taking the shared
# PV_ADMIN_TOKEN, so only staff tokens work.
PV_TOKEN_TTL_HOURS=10
PV_TOKENS_PER_USER=5
PV_ADMIN_SHARED_KEY=1
LOG_LEVEL=INFO
# Staging and production only (ADR 0001)
SENTRY_DSN=
