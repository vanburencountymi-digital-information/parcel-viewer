# Read-only database URL (parcel_studio_app or read-only service user)
PV_DATABASE_URL=postgresql://parcel_studio_app:CHANGE_ME@localhost:5432/postgres?sslmode=require

# Martin tile server (martin_ro user)
MARTIN_DATABASE_URL=postgresql://martin_ro:CHANGE_ME@localhost:5432/postgres?sslmode=require

# Browser-facing tile URL placeholder in /style.json
PV_MARTIN_PUBLIC_URL=/tiles
