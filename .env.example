# Parcel Viewer settings. Copy to .env and fill in; never commit .env.
# Each compose service receives only the settings listed for it in
# infra/docker-compose.*.yml (DIC-1871). Every setting and its default is documented in
# infra/DEPLOY-CHECKLIST.md; the commented ones below are optional.

# ── Required ────────────────────────────────────────────────────────────────────
# api: read-only database URL (parcel_studio_app or a read-only service user)
PV_DATABASE_URL=postgresql://parcel_studio_app:CHANGE_ME@localhost:5432/postgres?sslmode=require

# martin: tile server login (martin_ro user, SELECT-only)
MARTIN_DATABASE_URL=postgresql://martin_ro:CHANGE_ME@localhost:5432/postgres?sslmode=require

# Browser-facing tile URL placeholder in /style.json
PV_MARTIN_PUBLIC_URL=/tiles

# Host port for nginx (default 8080)
PV_HTTP_PORT=8080

# ── Production only (infra/docker-compose.prod.yml, the Django API; DIC-2150) ────
# Required there (compose refuses to start without them); the dev stack ignores them.
# DJANGO_SECRET_KEY=         # python -c "import secrets; print(secrets.token_urlsafe(48))"
# DJANGO_DB_PASSWORD=        # Django's own database; set before the first start
# PV_PUBLIC_HOST=            # the public host name, e.g. gis.vanburencountymi.gov
# Optional (the defaults fit the shared database's connection budget):
# GUNICORN_WORKERS=1
# DB_POOL_MAX=4
# SECURE_SSL_REDIRECT=1      # 0 only when serving over plain HTTP

# ── Local Map Buddy (dev compose only; production runs it on Cloud Run) ─────────
# MAP_BUDDY_ANTHROPIC_API_KEY=
# AI_QUOTA_DEFAULT=200
# AI_QUOTA_WINDOW=86400
# Map vision (DIC-2135): each look is one image-model call, counted as VISION_QUOTA_UNITS
# quota units, at most VISION_RATE_LIMIT per client. Unset VISION_EFFORT = model default.
# VISION_MODEL=claude-sonnet-5-5
# VISION_EFFORT=
# VISION_QUOTA_UNITS=1
# VISION_RATE_LIMIT=10/hour;30/day

# ── API: county config store (optional; without it the store lives in Django's database) ──
# PV_WRITER_DATABASE_URL=postgresql://pv_writer:CHANGE_ME@localhost:5432/postgres?sslmode=require

# ── api: "Report a problem" email (without a host the button fails with 503) ────
# PV_SMTP_HOST=
# PV_SMTP_PORT=587
# PV_SMTP_USER=
# PV_SMTP_PASSWORD=
# PV_REPORT_TO=gis@vanburencountymi.gov

# ── API: production origin ───────────────────────────────────────────────────────
# PV_CORS_ORIGINS=https://gis.dicemi.org

# ── Error reporting (api and map-buddy; ADR 0001) ───────────────────────────────
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# LOG_LEVEL=INFO
