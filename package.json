{
  "name": "parcel-viewer-web",
  "private": true,
  "description": "Builds the Parcel Viewer and Admin Console pages with Vite (DIC-2180). The e2e suite has its own package in e2e/.",
  "type": "commonjs",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "vite build --config vite.config.mjs",
    "dev": "vite build --watch --config vite.config.mjs",
    "test:build": "node --test tools/vite/classic-scripts.test.mjs"
  },
  "devDependencies": {
    "@turf/turf": "7.4.0",
    "maplibre-gl": "4.7.1",
    "proj4": "2.9.0",
    "rolldown": "1.2.13",
    "vite": "8.3.3"
  }
}
