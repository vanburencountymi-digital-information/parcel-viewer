{
  "name": "parcel-viewer-web",
  "private": true,
  "description": "Builds the Parcel Viewer and Admin Console pages with Vite (DIC-2180), including the Vue islands in frontend/src (DIC-2389). The e2e suite has its own package in e2e/.",
  "type": "commonjs",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "vite build --config vite.config.mjs",
    "dev": "vite build --watch --config vite.config.mjs",
    "test": "vitest run",
    "test:build": "node --test tools/vite/classic-scripts.test.mjs"
  },
  "devDependencies": {
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@turf/turf": "7.4.0",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/test-utils": "2.5.1",
    "happy-dom": "20.14.5",
    "maplibre-gl": "6.14.0",
    "proj4": "2.9.0",
    "rolldown": "1.2.13",
    "vite": "8.3.3",
    "vitest": "5.0.2",
    "vue": "3.5.43"
  }
}
